{
  "name": "car-rental-platform",
  "version": "0.0.0",
  "private": true,
  "description": "White-label car rental platform — npm-workspaces monorepo (api, dashboard, mobile + shared packages)",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev:api": "npm run dev -w @car-rental/api",
    "dev:dashboard": "npm run dev -w @car-rental/dashboard",
    "dev:mobile": "npm run start -w @car-rental/mobile",
    "lint": "eslint .",
    "format": "prettier --write .",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "eslint": "^9.17.0",
    "prettier": "^3.4.2",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.0"
  }
}
